@baseUrl = http://localhost:5000/api
@userId = 39e16f24-d8ab-456f-9f9f-c13981404346
@userEmail = test@laikipia.ac.OUR_DOMAIN
@regNumber = SC/COM/0008/22
@departmentId = 78e358e9-fa4d-4e9b-a556-070dcac0a6ab
@schoolId = f202bd75-b91f-45a4-a755-37f27f912ca3

### ============================================================================
### USERS ENDPOINTS TESTING
### ============================================================================

### 1. Get All Users
GET {{baseUrl}}/users
Content-Type: application/json

###

### 2. Get User By ID
GET {{baseUrl}}/users/{{userId}}
Content-Type: application/json

###

### 3. Get User By Email or Registration Number (e.g. SC/COM/0008/22)
GET {{baseUrl}}/users/identifier/{{regNumber}}
Content-Type: application/json

###

### 4. Get Users By Role (student | school_dean | hod | school_administrator)
GET {{baseUrl}}/users/role/student
Content-Type: application/json

###

### 5. Get Users By Department ID
GET {{baseUrl}}/users/department/{{departmentId}}
Content-Type: application/json

###

### 6. Get Users By School ID
GET {{baseUrl}}/users/school/{{schoolId}}
Content-Type: application/json

###

### 7. Update User Profile (Students cannot tamper with yearOfStudy here)
PATCH {{baseUrl}}/users/{{userId}}
Content-Type: application/json

{
  "name": "Brian Gakenye",
  "phoneNumber": "+254700000000",
  "yearOfStudy": 4 
}

###

### 8. Admin: Update User Academic Year (Handles promotions and deferments)
PATCH {{baseUrl}}/users/{{userId}}/academic-year
Content-Type: application/json

{
  "yearOfStudy": 4
}

###

### 9. Update User Role
PATCH {{baseUrl}}/users/{{userId}}/role
Content-Type: application/json

{
  "role": "student"
}

###

### 10. Toggle User Active Status
PATCH {{baseUrl}}/users/{{userId}}/status
Content-Type: application/json

{
  "isActive": true
}

###

### 11. Update Verification Status By Email
PATCH {{baseUrl}}/users/verification/{{userEmail}}
Content-Type: application/json

{
  "status": true
}

###

### 12. Delete User By ID
DELETE {{baseUrl}}/users/{{userId}}
Content-Type: application/json