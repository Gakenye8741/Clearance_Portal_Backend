@baseUrl = http://localhost:5000/api/non-academic-departments
# ab144880-12a0-46e9-a4b0-fb429c0c901c

@departmentId = ab144880-12a0-46e9-a4b0-fb429c0c901c
@departmentCode = LIB
@departmentType = service
@hodId = 6e44d895-f287-413f-9985-ad370949d064

### 1. Create Non-Academic Department
### 1. Catering Department
POST {{baseUrl}}
Content-Type: application/json

{
  "name": "Catering Department",
  "code": "CAD",
  "type": "service",
  "description": "University catering and food services",
  "isActive": true
}

